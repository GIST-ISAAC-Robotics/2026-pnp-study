<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pnp_bringup</name>
  <version>0.0.0</version>
  <description>Upper launch package for the PnP study.</description>
  <maintainer email="pnp-study@example.com">pnp-study</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>open_manipulator_bringup</exec_depend>
  <exec_depend>open_manipulator_moveit_config</exec_depend>
  <exec_depend>pnp_evaluation</exec_depend>
  <exec_depend>pnp_orchestrator</exec_depend>
  <exec_depend>pnp_perception</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
